# Port your Express server listens on
PORT=3000

# This server's own base URL. Neon Auth requires an Origin header on every
# call, including plain server-to-server ones with no browser involved, or
# it rejects the request with "Origin header is required".
APP_ORIGIN=http://localhost:3000

# Neon Auth base URL, found in your Neon Console under Project > Auth
# Format: https://ep-xxx.neonauth.c-2.us-east-2.aws.neon.build/<dbname>/auth
NEON_AUTH_URL=https://ep-xxx.neonauth.c-2.us-east-2.aws.neon.build/neondb/auth

# Same value as NEON_AUTH_URL. Used to build the JWKS endpoint and to check
# the "iss" claim on every token during verification.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.c-2.us-east-2.aws.neon.build/neondb/auth
